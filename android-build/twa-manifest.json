{
  "packageId": "app.vercel.sika_olive.twa",
  "host": "sika-olive.vercel.app",
  "name": "Sika — Expense Tracker",
  "launcherName": "Sika",
  "display": "standalone",
  "themeColor": "#10112A",
  "themeColorDark": "#000000",
  "navigationColor": "#000000",
  "navigationColorDark": "#000000",
  "navigationDividerColor": "#000000",
  "navigationDividerColorDark": "#000000",
  "backgroundColor": "#10112A",
  "enableNotifications": true,
  "startUrl": "/index.html",
  "iconUrl": "https://sika-olive.vercel.app/icon-512.png",
  "maskableIconUrl": "https://sika-olive.vercel.app/icon-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "android.keystore",
    "alias": "android"
  },
  "appVersionName": "1",
  "appVersionCode": 1,
  "shortcuts": [
    {
      "name": "Add expense",
      "shortName": "Add",
      "url": "https://sika-olive.vercel.app/index.html?action=add",
      "chosenIconUrl": "https://sika-olive.vercel.app/icon-192.png"
    },
    {
      "name": "Summary",
      "shortName": "Summary",
      "url": "https://sika-olive.vercel.app/index.html?action=summary",
      "chosenIconUrl": "https://sika-olive.vercel.app/icon-192.png"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://sika-olive.vercel.app/manifest.json",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://sika-olive.vercel.app/",
  "minSdkVersion": 21,
  "shareTarget": {
    "action": "https://sika-olive.vercel.app/index.html",
    "method": "GET",
    "params": {
      "title": "shared_title",
      "text": "shared_text"
    }
  },
  "orientation": "portrait",
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "protocolHandlers": [
    {
      "protocol": "web+sika",
      "url": "https://sika-olive.vercel.app/index.html?entry=%s"
    }
  ],
  "fileHandlers": [
    {
      "actionUrl": "https://sika-olive.vercel.app/index.html",
      "mimeTypes": [
        "application/json"
      ]
    }
  ],
  "launchHandlerClientMode": "focus-existing",
  "displayOverride": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "appVersion": "1"
}