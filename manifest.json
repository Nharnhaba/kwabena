{
  "id": "/kwabena/",
  "name": "Sika — Expense Tracker",
  "short_name": "Sika",
  "description": "Track your mobile money and cash spending, income, and budgets — right from your phone.",
  "start_url": "/kwabena/",
  "scope": "/kwabena/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#10112a",
  "theme_color": "#10112a",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "productivity", "utilities"],
  "prefer_related_applications": false,
  "iarc_rating_id": "",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "screenshots": [
    { "src": "screenshot-dashboard.png", "sizes": "1080x2280", "type": "image/png", "form_factor": "narrow", "label": "Dashboard with balance, income, and spending" },
    { "src": "screenshot-add.png", "sizes": "1080x2280", "type": "image/png", "form_factor": "narrow", "label": "Add an expense or income entry" },
    { "src": "screenshot-categories.png", "sizes": "1080x2280", "type": "image/png", "form_factor": "narrow", "label": "Spending and income by category" }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Add",
      "description": "Quickly log a new expense",
      "url": "/kwabena/?action=add",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Summary",
      "short_name": "Summary",
      "description": "See your monthly summary",
      "url": "/kwabena/?action=summary",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/kwabena/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/kwabena/",
      "accept": {
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+sika",
      "url": "/kwabena/?entry=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "note_taking": {
    "new_note_url": "/kwabena/?action=add"
  }
}